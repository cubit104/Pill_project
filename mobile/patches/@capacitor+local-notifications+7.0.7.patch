diff --git a/node_modules/@capacitor/local-notifications/ios/Sources/LocalNotificationsPlugin/LocalNotificationsPlugin.swift b/node_modules/@capacitor/local-notifications/ios/Sources/LocalNotificationsPlugin/LocalNotificationsPlugin.swift
index 463be9a..3f7cbfd 100644
--- a/node_modules/@capacitor/local-notifications/ios/Sources/LocalNotificationsPlugin/LocalNotificationsPlugin.swift
+++ b/node_modules/@capacitor/local-notifications/ios/Sources/LocalNotificationsPlugin/LocalNotificationsPlugin.swift
@@ -263,6 +263,22 @@ public class LocalNotificationsPlugin: CAPPlugin, CAPBridgedPlugin {
             content.sound = UNNotificationSound(named: UNNotificationSoundName(sound))
         }
 
+        // PillSeek patch: allow an app-icon badge number on local notifications.
+        if let badge = notification["badge"] as? Int {
+            content.badge = NSNumber(value: badge)
+        }
+
+        // PillSeek patch: interruption level, so a dose reminder can be Time Sensitive
+        // (breaks through Focus / Do Not Disturb and shows the larger banner).
+        if #available(iOS 15.0, *), let level = notification["interruptionLevel"] as? String {
+            switch level {
+            case "passive": content.interruptionLevel = .passive
+            case "timeSensitive": content.interruptionLevel = .timeSensitive
+            case "critical": content.interruptionLevel = .critical
+            default: content.interruptionLevel = .active
+            }
+        }
+
         if let attachments = notification["attachments"] as? [JSObject] {
             content.attachments = try makeAttachments(attachments)
         }
